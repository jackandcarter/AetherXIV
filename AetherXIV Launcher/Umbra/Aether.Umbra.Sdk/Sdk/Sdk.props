<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <UmbraApiVersion>2.0</UmbraApiVersion>
    <UmbraPluginManifest Condition="'$(UmbraPluginManifest)' == ''">$(MSBuildProjectDirectory)/umbra-plugin.json</UmbraPluginManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aether.Umbra.PluginApi"
                      Version="2.0.0"
                      ExcludeAssets="runtime"
                      PrivateAssets="all" />
    <None Include="$(UmbraPluginManifest)"
          Link="umbra-plugin.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(UmbraPluginManifest)')" />
  </ItemGroup>
</Project>
