<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Aether.Umbra.PluginApi is not published to nuget.org: the framework ships
    it inside the launcher payload and provides the contract at runtime. The
    Umbra tree resolves it from the repository-local feed that
    tools/Universal/package-umbra-pluginapi.py packs into <repo>/.umbra-nuget
    (CI populates it before each platform/SDK build; the bundled-plugin
    packaging script populates it automatically when the package is missing).
  -->
  <packageSources>
    <add key="AetherXIV Umbra local feed" value="../../.umbra-nuget" />
  </packageSources>
</configuration>
